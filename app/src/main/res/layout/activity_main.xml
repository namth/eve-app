<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <!-- 1. Full Screen EVE Robot Interface (WebView 60fps) -->
    <WebView
        android:id="@+id/eveWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A" />

    <!-- 2. Compact Top Header Bar -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- User Badge Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActivePerson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#D91E293B"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#3300F0FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/tvActivePerson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 EVE AI"
                    android:textColor="#00F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Hidden tier badge to preserve binding compatibility -->
                <TextView
                    android:id="@+id/tvTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Switch Camera Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#D91E293B"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#3300F0FF"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đổi camera"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#00F0FF" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#D91E293B"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeColor="#3300F0FF"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cài đặt"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#00F0FF" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. EVE Speech Subtitle Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSpeechBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E60F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout"
        app:strokeColor="#10B981"
        app:strokeWidth="1.5dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSpeechText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="👋 Chào bạn Nam! Em rất vui được gặp bạn."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Camera Picture-in-Picture (PiP) Widget (Bottom-Left) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCameraPiP"
        android:layout_width="100dp"
        android:layout_height="130dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="28dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#00F0FF"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/pipPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />

            <com.example.facedetector.ui.BoundingBoxOverlay
                android:id="@+id/pipOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Minimized Icon Overlay (Visible when PiP minimized) -->
            <TextView
                android:id="@+id/tvPipMinimizedIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📷"
                android:textColor="#00F0FF"
                android:textSize="20sp"
                android:visibility="gone" />

            <!-- Toggle Button in Corner -->
            <TextView
                android:id="@+id/btnTogglePiP"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:background="#D90F172A"
                android:gravity="center"
                android:text="━"
                android:textColor="#00F0FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. Voice Input Controls (Center Bottom) -->
    <LinearLayout
        android:id="@+id/voiceControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#00F0FF"
            android:contentDescription="Nói chuyện với EVE"
            android:src="@android:drawable/ic_btn_speak_now"
            app:elevation="8dp"
            app:fabCustomSize="64dp"
            app:tint="#0F172A" />

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#B30F172A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Chạm để nói chuyện"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>